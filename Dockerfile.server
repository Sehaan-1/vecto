# syntax=docker/dockerfile:1
FROM golang:1.24-alpine AS builder

WORKDIR /src

COPY go.mod go.sum ./
RUN go mod download

COPY . .

RUN CGO_ENABLED=0 go build -ldflags="-s -w" -o /out/vecto-server ./cmd/vecto-server

# Minimal scratch or alpine runtime
FROM alpine:3.21

RUN apk add --no-cache ca-certificates

COPY --from=builder /out/vecto-server /usr/local/bin/vecto-server

VOLUME /data
EXPOSE 8463

ENTRYPOINT ["vecto-server", "-addr", "0.0.0.0:8463", "-dir", "/data"]
